[Unit]
Description=Apache Gravitino Metadata Lake Management Server
Documentation=https://gravitino.apache.org/docs/
After=network.target zookeeper.service postgresql.service  # 依赖网络、ZooKeeper、数据库

[Service]
User=gravitino
Group=gravitino
EnvironmentFile=/etc/gravitino/conf/gravitino-env.sh  # 加载环境变量
ExecStart=/usr/lib/gravitino/bin/start-server.sh  # 启动命令
ExecStop=/usr/lib/gravitino/bin/stop-server.sh  # 停止命令
PIDFile=/var/run/gravitino/gravitino.pid  # PID 文件路径
Restart=on-failure  # 失败时自动重启
RestartSec=5  # 重启间隔 5 秒
LimitNOFILE=65536  # 提高文件描述符限制

[Install]
WantedBy=multi-user.target  # 多用户模式下启动
