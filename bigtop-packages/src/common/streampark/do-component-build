set -euo pipefail

# 配置构建环境
export MAVEN_OPTS="-Xms2g -Xmx4g"

# 安装前端依赖并构建
echo "Building frontend assets..."
mvn -Pscala-2.12,dist -DskipTests clean package

# 验证构建产物
BUILD_DIR="streampark-dist/target"
if [ ! -f "${BUILD_DIR}/apache-streampark-${STREAMPARK_VERSION}-bin.tar.gz" ]; then
    echo "Error: Build artifact not found in ${BUILD_DIR}"
    exit 1
fi

# 准备安装源目录
mkdir -p dist
tar -zxf ${BUILD_DIR}/apache-streampark-${STREAMPARK_VERSION}-bin.tar.gz -C dist --strip-components=1

echo "Build completed successfully. Output in dist/"
