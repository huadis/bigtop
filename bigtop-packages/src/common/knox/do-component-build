set -euo pipefail

# 配置编译参数
KNOX_VERSION="2.0.0"
MAVEN_OPTS="${MAVEN_OPTS:--Xmx2g -XX:MetaspaceSize=512m}"
MVN_CMD="${MVN_CMD:-mvn}"
BUILD_DIR="${BUILD_DIR:-build}"
DIST_DIR="${BUILD_DIR}/dist"

# 检查必要的命令
check_dependency() {
    if ! command -v "$1" &> /dev/null; then
        echo "错误: 未找到必需的命令 '$1'，请安装后重试"
        exit 1
    fi
}

# 检查Java和Maven是否安装
check_dependency "java"
check_dependency "$MVN_CMD"

# 验证Java版本 (Knox 2.0.0需要Java 8或11)
JAVA_VERSION=$(java -version 2>&1 | awk -F '"' '/version/ {print $2}')
JAVA_MAJOR=$(echo "$JAVA_VERSION" | awk -F. '{if ($1 == "1") print $2; else print $1}')

if [[ "$JAVA_MAJOR" -lt 8 || "$JAVA_MAJOR" -gt 11 ]]; then
    echo "错误: Knox 2.0.0需要Java 8或11，当前版本: $JAVA_VERSION"
    exit 1
fi

echo "开始编译Apache Knox $KNOX_VERSION..."
echo "使用Java版本: $JAVA_VERSION"
echo "使用Maven命令: $MVN_CMD"

# 清理之前的构建产物
echo "清理旧构建..."
$MVN_CMD clean

# 执行编译、测试和打包
# 跳过签名和文档生成以加速构建 (生产环境可移除相关参数)
echo "开始构建过程..."
$MVN_CMD package \
    -DskipTests \
    -Dmaven.javadoc.skip=true \
    -Dgpg.skip=true \
    -Dproject.version="$KNOX_VERSION" \
    -Ppackage \
    -e

# 验证构建结果
if [[ ! -d "$DIST_DIR" || -z "$(ls -A "$DIST_DIR")" ]]; then
    echo "错误: 构建失败，未生成分发文件"
    exit 1
fi

# 显示构建结果信息
echo "构建成功！"
echo "分发文件位于: $DIST_DIR"
echo "分发内容:"
ls -la "$DIST_DIR"


