set -euo pipefail

# 定义版本（从环境变量或源码中获取）
SEATUNNEL_VERSION=${SEATUNNEL_VERSION:-$(cat VERSION 2>/dev/null || echo "2.3.3")}

# 配置 Maven 环境（增加内存，使用 BigTop 仓库加速）
export MAVEN_OPTS="-Xms2g -Xmx4g"
MAVEN_SETTINGS=${MAVEN_SETTINGS:-/etc/maven/settings.xml}

# 编译源码（跳过测试，激活 distribution 配置）
echo "Starting to build Apache SeaTunnel ${SEATUNNEL_VERSION}..."
mvn clean package -pl seatunnel-dist -am -DskipTests -Dmaven.javadoc.skip=true

# 验证构建产物
BUILD_DIR="seatunnel-dist/target"
if [ ! -f "${BUILD_DIR}/apache-seatunnel-${SEATUNNEL_VERSION}-bin.tar.gz" ]; then
    echo "Error: Build artifact not found in ${BUILD_DIR}. Build failed."
    exit 1
fi

# 解压构建产物到 dist 目录（供安装脚本使用）
mkdir -p dist
tar -zxf "${BUILD_DIR}/apache-seatunnel-${SEATUNNEL_VERSION}-bin.tar.gz" -C dist --strip-components=1

# 复制插件到 dist 目录（SeaTunnel 插件需单独存放）
cp -r seatunnel-plugins/* dist/plugins/

echo "Build completed successfully. Output in dist/"
