[Unit]
Description=Apache SeaTunnel Distributed Data Integration Server
Documentation=https://seatunnel.apache.org/docs/
After=network.target zookeeper.service flink.service  # 依赖网络、ZooKeeper、Flink

[Service]
User=seatunnel
Group=seatunnel
EnvironmentFile=/etc/seatunnel/conf/seatunnel-env.sh  # 加载环境变量
ExecStart=/usr/lib/seatunnel/bin/start-server.sh  # 启动集群服务
ExecStop=/usr/lib/seatunnel/bin/stop-server.sh    # 停止集群服务
PIDFile=/var/run/seatunnel/seatunnel.pid
Restart=on-failure  # 失败时自动重启
RestartSec=10       # 重启间隔 10 秒
LimitNOFILE=65536   # 提高文件描述符限制（处理大量数据连接）

[Install]
WantedBy=multi-user.target  # 多用户模式下启动
